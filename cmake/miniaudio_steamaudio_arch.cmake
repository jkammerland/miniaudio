function(miniaudio_select_steamaudio_arch output_variable system_name system_processor target_processor pointer_size)
    string(TOLOWER "${system_processor}" processor)
    string(TOLOWER "${target_processor}" target)
    set(result "")

    if(system_name STREQUAL "Darwin")
        set(result osx)
    elseif(system_name STREQUAL "Windows")
        if(pointer_size EQUAL 8 AND target MATCHES "^(amd64|x86_64|x64)$")
            set(result windows-x64)
        elseif(pointer_size EQUAL 4 AND target MATCHES "^(amd64|x86_64|x64|win32|x86|i[3-6]86)$")
            set(result windows-x86)
        endif()
    elseif(system_name STREQUAL "Linux")
        if(pointer_size EQUAL 8 AND processor MATCHES "^(amd64|x86_64|x64)$")
            set(result linux-x64)
        elseif(pointer_size EQUAL 4 AND processor MATCHES "^(amd64|x86_64|x64|x86|i[3-6]86)$")
            set(result linux-x86)
        endif()
    endif()

    set(${output_variable} "${result}" PARENT_SCOPE)
endfunction()
